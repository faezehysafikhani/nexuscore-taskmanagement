# Backend API Configuration
# Used by server.ts (the Node dev/prod server) as the target it proxies /api requests to -
# "localhost" is correct there since the backend runs on the same machine as this server.
# It is also baked into the browser bundle for the SignalR hub connection (/hubs), which
# connects directly rather than through the proxy - so if the UI is opened from another
# host/IP (not localhost), set this to that server's LAN-reachable address/port instead of
# localhost, or SignalR will try to reach the browser's own machine and fail.
VITE_API_BASE_URL=http://localhost:5151

# Server environment variables
PORT=3030
NODE_ENV=development
# Set a long random value of your own (never reuse a value from a document or a chat).
JWT_SECRET=

# Supabase Database Integration
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_PASSWORD=
SUPABASE_DB_CONNECTION_STRING=

# Client-side (Optional for direct frontend subscriptions)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
