<Project Sdk="Microsoft.NET.Sdk.Web">

	<PropertyGroup>
		<TargetFramework>net8.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<OutputType>Library</OutputType>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="FluentValidation" Version="11.11.0" />
	</ItemGroup>

	<ItemGroup>
		<!-- Required dependencies: Users (NexusCore, always present), Organization, Calendar.
         ProjectManagement.Core is deliberately NOT referenced - the Project relation is an
         optional, bare Guid so Actions works fully standalone. -->
		<ProjectReference Include="..\Nexus.Organization\Nexus.Organization.csproj" />
		<ProjectReference Include="..\Nexus.Calendar\Nexus.Calendar.csproj" />
		<ProjectReference Include="..\NexusCore.Application\NexusCore.Application.csproj" />
		<ProjectReference Include="..\NexusCore.SharedKernel\NexusCore.SharedKernel.csproj" />
	</ItemGroup>

</Project>
