<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.TestHost" Version="8.0.12" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" Version="8.0.24" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="8.0.24" />
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.1" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <!-- This project intentionally reaches across module boundaries no other project is allowed
       to - its whole job is to compose modules together and check the results, the same way an
       external product host does. See ArchitectureDependencyTests for the complementary check
       that every *other* project's boundaries are respected. -->
  <ItemGroup>
    <ProjectReference Include="..\NexusCore.Application\NexusCore.Application.csproj" />
    <ProjectReference Include="..\NexusCore.Infrastructure\NexusCore.Infrastructure.csproj" />
    <ProjectReference Include="..\NexusCore.SharedKernel\NexusCore.SharedKernel.csproj" />
    <!-- AccessControlTests: the modules the task manager uses, composed over HTTP. -->
    <ProjectReference Include="..\Nexus.TaskManagement\Nexus.TaskManagement.csproj" />
    <ProjectReference Include="..\Nexus.TaskManagement.Infrastructure\Nexus.TaskManagement.Infrastructure.csproj" />
    <ProjectReference Include="..\Ticketing.Api\Ticketing.Api.csproj" />
    <ProjectReference Include="..\Ticketing.Application\Ticketing.Application.csproj" />
    <ProjectReference Include="..\Ticketing.Infrastructure\Ticketing.Infrastructure.csproj" />
    <!-- RecurringTaskReminderTests: due recurring tasks through notifications and SMS. -->
    <ProjectReference Include="..\Nexus.Integrations.TaskNotifications\Nexus.Integrations.TaskNotifications.csproj" />
    <!-- NotificationInboxTests: the notification endpoints the bell reads. -->
    <ProjectReference Include="..\Notifications.Api\Notifications.Api.csproj" />
    <ProjectReference Include="..\Notifications.Infrastructure\Notifications.Infrastructure.csproj" />
    <!-- ChatTests: direct and team conversations through the real endpoints. -->
    <ProjectReference Include="..\Chat.Api\Chat.Api.csproj" />
    <ProjectReference Include="..\Chat.Application\Chat.Application.csproj" />
    <ProjectReference Include="..\Chat.Infrastructure\Chat.Infrastructure.csproj" />

    <ProjectReference Include="..\Nexus.Actions\Nexus.Actions.csproj" />
    <ProjectReference Include="..\Nexus.Actions.Infrastructure\Nexus.Actions.Infrastructure.csproj" />
    <ProjectReference Include="..\Nexus.Knowledge\Nexus.Knowledge.csproj" />
    <ProjectReference Include="..\Nexus.Knowledge.Infrastructure\Nexus.Knowledge.Infrastructure.csproj" />
    <ProjectReference Include="..\Nexus.Workflow\Nexus.Workflow.csproj" />
    <ProjectReference Include="..\Nexus.Workflow.Infrastructure\Nexus.Workflow.Infrastructure.csproj" />

    <ProjectReference Include="..\Nexus.ProjectManagement.Core\Nexus.ProjectManagement.Core.csproj" />
    <ProjectReference Include="..\Nexus.ProjectManagement.Core.Infrastructure\Nexus.ProjectManagement.Core.Infrastructure.csproj" />
    <ProjectReference Include="..\Nexus.ProjectManagement.Waterfall\Nexus.ProjectManagement.Waterfall.csproj" />
    <ProjectReference Include="..\Nexus.ProjectManagement.Waterfall.Infrastructure\Nexus.ProjectManagement.Waterfall.Infrastructure.csproj" />
    <ProjectReference Include="..\Nexus.ProjectManagement.Risk\Nexus.ProjectManagement.Risk.csproj" />
    <ProjectReference Include="..\Nexus.ProjectManagement.Risk.Infrastructure\Nexus.ProjectManagement.Risk.Infrastructure.csproj" />
    <ProjectReference Include="..\Nexus.ProjectManagement.Agile\Nexus.ProjectManagement.Agile.csproj" />
    <ProjectReference Include="..\Nexus.ProjectManagement.Agile.Infrastructure\Nexus.ProjectManagement.Agile.Infrastructure.csproj" />
    <ProjectReference Include="..\Nexus.ProjectManagement.Contracts\Nexus.ProjectManagement.Contracts.csproj" />
    <ProjectReference Include="..\Nexus.ProjectManagement.Contracts.Infrastructure\Nexus.ProjectManagement.Contracts.Infrastructure.csproj" />
    <ProjectReference Include="..\Nexus.ProjectManagement.Stakeholder\Nexus.ProjectManagement.Stakeholder.csproj" />
    <ProjectReference Include="..\Nexus.ProjectManagement.Progress\Nexus.ProjectManagement.Progress.csproj" />
    <ProjectReference Include="..\Nexus.ProjectManagement.Progress.Infrastructure\Nexus.ProjectManagement.Progress.Infrastructure.csproj" />
    <ProjectReference Include="..\Nexus.ProjectManagement.Documents\Nexus.ProjectManagement.Documents.csproj" />
    <ProjectReference Include="..\Nexus.ProjectManagement.Documents.Infrastructure\Nexus.ProjectManagement.Documents.Infrastructure.csproj" />
    <ProjectReference Include="..\Nexus.ProjectManagement.Kpi\Nexus.ProjectManagement.Kpi.csproj" />
    <ProjectReference Include="..\Nexus.ProjectManagement.Team\Nexus.ProjectManagement.Team.csproj" />
    <ProjectReference Include="..\Nexus.Portfolio\Nexus.Portfolio.csproj" />
    <ProjectReference Include="..\Nexus.Reporting\Nexus.Reporting.csproj" />
    <ProjectReference Include="..\Nexus.Integrations.ProjectVisibility\Nexus.Integrations.ProjectVisibility.csproj" />
    <ProjectReference Include="..\Nexus.ProjectManagement.History\Nexus.ProjectManagement.History.csproj" />
    <ProjectReference Include="..\Nexus.ProjectManagement.History.Infrastructure\Nexus.ProjectManagement.History.Infrastructure.csproj" />
    <ProjectReference Include="..\Nexus.Organization\Nexus.Organization.csproj" />
    <ProjectReference Include="..\Nexus.Strategy\Nexus.Strategy.csproj" />
    <ProjectReference Include="..\Nexus.Integrations.ProjectStrategyAlignment\Nexus.Integrations.ProjectStrategyAlignment.csproj" />
    <ProjectReference Include="..\Nexus.Calendar\Nexus.Calendar.csproj" />
    <ProjectReference Include="..\Nexus.Integrations.ProjectCalendar\Nexus.Integrations.ProjectCalendar.csproj" />
  </ItemGroup>

  <!-- Notifications.Api ships an appsettings.json that is not valid JSON; keep it out of this
       project's output so the test hosts keep loading the one they loaded before. -->
  <Target Name="SkipNotificationsApiSettings" AfterTargets="GetCopyToOutputDirectoryItems">
    <ItemGroup>
      <_NotificationsApiSettings Include="@(_SourceItemsToCopyToOutputDirectory);@(_SourceItemsToCopyToOutputDirectoryAlways)" Condition="$([System.String]::Copy('%(FullPath)').Contains('Notifications.Api')) And '%(Filename)' == 'appsettings'" />
      <_SourceItemsToCopyToOutputDirectory Remove="@(_NotificationsApiSettings)" />
      <_SourceItemsToCopyToOutputDirectoryAlways Remove="@(_NotificationsApiSettings)" />
    </ItemGroup>
  </Target>

</Project>
