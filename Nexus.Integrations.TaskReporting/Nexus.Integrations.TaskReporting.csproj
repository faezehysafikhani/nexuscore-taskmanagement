<Project Sdk="Microsoft.NET.Sdk.Web">

	<PropertyGroup>
		<TargetFramework>net8.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<OutputType>Library</OutputType>
	</PropertyGroup>

	<!-- Optional integration: task reports that follow the organization structure (a manager
	     sees all of their subordinates' tasks). Only hosts that compose both Task Management and
	     Nexus.OrgStructure and reference this package get it; neither module depends on it. -->
	<ItemGroup>
		<ProjectReference Include="..\Nexus.TaskManagement.Infrastructure\Nexus.TaskManagement.Infrastructure.csproj" />
		<ProjectReference Include="..\Nexus.OrgStructure\Nexus.OrgStructure.csproj" />
		<ProjectReference Include="..\NexusCore.Application\NexusCore.Application.csproj" />
	</ItemGroup>

</Project>
