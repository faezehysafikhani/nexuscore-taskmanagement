{
  "ConnectionStrings": {
    "DefaultConnection": "Server=.;Database=NexusCore;Trusted_Connection=True;MultipleActiveResultSets=true;TrustServerCertificate=True",
    "Chat": "Server=.;Database=NexusCoreChat;Trusted_Connection=True;TrustServerCertificate=True",
    "Ticket": "Server=.;Database=NexusCoreTicket;Trusted_Connection=True;TrustServerCertificate=True"
  },
  "Jwt": {
    "Issuer": "NexusCore",
    "Audience": "NexusCore",
    "SigningKey": "replace-this-development-secret-with-a-production-secret-32chars",
    "AccessTokenMinutes": 30
  },
  "Database": {
    "SeedOnStartup": true
  },
  "NexusCore": {
    "RateLimiting": {
      "Enabled": true,
      "Global": {
        "PermitLimit": 600,
        "WindowMinutes": 1
      },
      "Auth": {
        "PermitLimit": 10,
        "WindowMinutes": 1
      },
      "PasswordRecovery": {
        "PermitLimit": 5,
        "WindowMinutes": 15
      },
      "PasswordResetVerification": {
        "PermitLimit": 10,
        "WindowMinutes": 15
      },
      "AuthenticatedApi": {
        "PermitLimit": 300,
        "WindowMinutes": 1
      },
      "Write": {
        "PermitLimit": 120,
        "WindowMinutes": 1
      },
      "Upload": {
        "PermitLimit": 20,
        "WindowMinutes": 5
      },
      "ChatSend": {
        "PermitLimit": 60,
        "WindowMinutes": 1
      },
      "Sms": {
        "PermitLimit": 5,
        "WindowMinutes": 5
      },
      "Realtime": {
        "PermitLimit": 120,
        "WindowMinutes": 1
      }
    }
  },
  // Cors:AllowedOrigins is deliberately not set here - it's environment-specific, so it belongs
  // in appsettings.Development.json (dev origins) or appsettings.Production.json (the real
  // deployment's origin, set at install time). See DEPLOYMENT-CONFIG.md.
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    }
  },
  "AllowedHosts": "*"
}
