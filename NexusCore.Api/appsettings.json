{
  "ConnectionStrings": {
    "DefaultConnection": "Server=.;Database=NexusCore;Trusted_Connection=True;MultipleActiveResultSets=true;TrustServerCertificate=True",
    "Chat": "Server=.;Database=NexusCoreChat;Trusted_Connection=True;TrustServerCertificate=True",
    "Ticket": "Server=.;Database=NexusCoreTicket;Trusted_Connection=True;TrustServerCertificate=True"
  },
  "Jwt": {
    "Issuer": "NexusCore",
    "Audience": "NexusCore",
    "SigningKey": "replace-this-development-secret-with-a-production-secret-32chars",
    "AccessTokenMinutes": 30
  },
  "Database": {
    "SeedOnStartup": true
  },
  "Cors": {
    // No origin is allowed by default. Each deployment lists the exact origin(s) its frontend
    // is served from, e.g. ["https://your-domain.example"]. Development origins live in
    // appsettings.Development.json instead of here.
    "AllowedOrigins": []
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    }
  },
  "AllowedHosts": "*"
}
