{
  "ConnectionStrings": {
    "DefaultConnection": "Server=.;Database=NexusCore;Trusted_Connection=True;MultipleActiveResultSets=true;TrustServerCertificate=True",
    "Chat": "Server=.;Database=NexusCoreChat;Trusted_Connection=True;TrustServerCertificate=True",
    "Ticket": "Server=.;Database=NexusCoreTicket;Trusted_Connection=True;TrustServerCertificate=True"
  },
  "Jwt": {
    "Issuer": "NexusCore",
    "Audience": "NexusCore",
    "SigningKey": "replace-this-development-secret-with-a-production-secret-32chars",
    "AccessTokenMinutes": 30
  },
  "Database": {
    "SeedOnStartup": true
  },
  "Cors": {
    // localhost/127.0.0.1 identify no real network or deployment - they mean "this same
    // machine" everywhere, so keeping them here (unlike a real LAN IP or domain) doesn't leak
    // any environment detail and lets a same-machine install work without extra configuration.
    // A real deployment adds its actual frontend origin(s) here too, e.g.
    // "https://your-domain.example" - never a placeholder for the environment this ships to.
    "AllowedOrigins": [
      "http://localhost:3030",
      "http://127.0.0.1:3030"
    ]
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    }
  },
  "AllowedHosts": "*"
}
