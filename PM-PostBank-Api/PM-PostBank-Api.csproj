<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>postbank-api</UserSecretsId>
    <!-- A product host, not a Core package. -->
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Serilog.AspNetCore" Version="8.0.3" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.9.0" />
  </ItemGroup>

  <!-- PostBank composes the NexusCore platform through the two bundles, referenced here as projects of this
       solution (no package build or offline feed in between). Each brings the modules it composes:
         Nexus.Bundles.Platform           users, roles, sessions, organization, calendar, workflow,
                                          chat, events, ticketing, notifications
         Nexus.Bundles.ProjectManagement  every project-management module, its integrations, portfolio,
                                          reporting, plus actions, knowledge and strategy
       To use less, reference the individual module projects instead of a bundle. -->
  <ItemGroup>
    <ProjectReference Include="..\Nexus.Bundles.Platform\Nexus.Bundles.Platform.csproj" />
    <ProjectReference Include="..\Nexus.Bundles.ProjectManagement\Nexus.Bundles.ProjectManagement.csproj" />
  </ItemGroup>

</Project>
