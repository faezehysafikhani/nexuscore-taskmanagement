{
  "ConnectionStrings": {
    "DefaultConnection": "Server=.;Database=PostBank;Trusted_Connection=True;MultipleActiveResultSets=true;TrustServerCertificate=True",
    "Chat": "Server=.;Database=PostBankChat;Trusted_Connection=True;TrustServerCertificate=True",
    "Ticket": "Server=.;Database=PostBankTicket;Trusted_Connection=True;TrustServerCertificate=True"
  },
  "Jwt": {
    "Issuer": "PostBank",
    "Audience": "PostBank",
    "SigningKey": "replace-this-development-secret-with-a-production-secret-32chars",
    "AccessTokenMinutes": 30
  },
  "Features": {
    "UserGroups": {
      "Enabled": false
    }
  },
  "Database": {
    "SeedOnStartup": true
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    }
  },
  "AllowedHosts": "*"
}
