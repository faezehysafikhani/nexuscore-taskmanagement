{
  "ConnectionStrings": {
    "DefaultConnection": "Server=.;Database=PostbankPM;Trusted_Connection=True;MultipleActiveResultSets=true;TrustServerCertificate=True",
    "Chat": "Server=.;Database=PostbankPMChat;Trusted_Connection=True;TrustServerCertificate=True"
  },
  "Jwt": {
    "Issuer": "PostbankPM",
    "Audience": "PostbankPM.UI",
    "SigningKey": "replace-this-development-secret-with-a-production-secret-32chars",
    "AccessTokenMinutes": 30
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000",
      "https://localhost:3000",
      "http://localhost:5173",
      "https://localhost:5173"
    ]
  },
  "Features": {
    "UserGroups": {
      "Enabled": false
    }
  },
  "Database": {
    "SeedOnStartup": true
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    }
  },
  "AllowedHosts": "*"
}
