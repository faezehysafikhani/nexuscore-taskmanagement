{
  "ConnectionStrings": {
    "DefaultConnection": "Server=.;Database=TaskManagerDb;Trusted_Connection=True;MultipleActiveResultSets=true;TrustServerCertificate=True",
    "Chat": "Server=.;Database=TaskManagerDbChat;Trusted_Connection=True;TrustServerCertificate=True",
    "Ticket": "Server=.;Database=TaskManagerDbTicket;Trusted_Connection=True;TrustServerCertificate=True"
  },
  "Jwt": {
    "Issuer": "Rozet",
    "Audience": "Rozet",
    "SigningKey": "replace-this-development-secret-with-a-production-secret-32chars",
    "AccessTokenMinutes": 30
  },
  "Features": {
    "UserGroups": {
      "Enabled": true
    }
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3030",
      "http://127.0.0.1:3030",
      "http://192.168.100.64:3000",
      "https://192.168.100.64:3000"
    ]
  },
  "Database": {
    "SeedOnStartup": true
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "TaskManagement": {
    "Scheduler": {
      "Enabled": false,
      "PollIntervalSeconds": 60,
      "BatchSize": 100
    }
  },
  "Identity": {
    "AdminUsername": "admin",
    "LoginProtection": {
      "CaptchaAfterFailedAttempts": 1,
      "FailureWindowMinutes": 30,
      "MaxFailedAttemptsPerIdentifier": 10,
      "CaptchaLifetimeSeconds": 120,
      "MaxLoginAttemptsPerClient": 30,
      "LoginWindowMinutes": 5
    },
    "SeedRoles": [
      {
        "Name": "Member",
        "Description": "Task manager users: tasks, notes, chat and their own work teams",
        "Permissions": [
          "Tasks.View",
          "Tasks.Create",
          "Tasks.Edit",
          "Tasks.Delete",
          "Tasks.Assign",
          "Tasks.ManageRecurring",
          "Tasks.ManageTags",
          "Tasks.UploadFiles",
          "Tasks.Comment",
          "Notes.Manage",
          "users.view",
          "groups.manage_own"
        ]
      }
    ]
  },
  "PasswordReset": {
    "CodeLength": 6,
    "CodeLifetimeMinutes": 5,
    "ResetTokenLifetimeMinutes": 10
  },
  "Email": {
    "Smtp": {
      "Host": "",
      "Port": 587,
      "EnableSsl": true,
      "UserName": "",
      "Password": "",
      "FromAddress": "",
      "FromName": "",
      "PickupDirectory": ""
    }
  },
  "Chat": {
    "MaxAttachmentBytes": 5242880
  }
}
