{
  // Serilog (the log the API writes): every SQL query at Information would be printed - slow, above all on a
  // Windows console, where it can turn a board load of seconds into minutes. Queries are logged only when they fail.
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System": "Warning"
      }
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Server=.;Database=TMPB;Trusted_Connection=True;TrustServerCertificate=True;",
    "Chat": "Server=.;Database=TMPB;Trusted_Connection=True;TrustServerCertificate=True;"
  },
  "Jwt": {
    "Issuer": "TMPB",
    "Audience": "TMPB"
  },
  "Database": {
    "SeedOnStartup": true,
    // Organization / OrgStructure schemas: created on a new database and brought up to date on an
    // existing one at start-up. false: a DBA runs the scripts in db/ instead (DEPLOYMENT-CONFIG.md).
    "InitializeOrgStructureSchema": true
  },
  "Features": {
    "UserGroups": {
      "Enabled": true
    }
  },
  // Tasks only to one's own level and below in the org chart (people with no place yet are free;
  // the permission «ارجاع فعالیت به همه‌ی سطوح سازمانی» lifts it). false: anyone to anyone.
  "OrgStructure": {
    "LimitTaskAssignment": true,
    // Tasks are given to posts, not people: when a post changes hands its tasks go with it.
    "AssignTasksToPosts": true,
    // Everyone sees, messages and gives tasks only to their own company (the permission «دسترسی
    // به همه‌ی شرکت‌ها» lifts it). false: the companies are open to one another.
    "LimitToOwnCompany": true,
    // Direct chat only with one's peers (same manager, same unit), those below, one's manager and the
    // manager's manager. false: anyone (within the company).
    "LimitChatToHierarchy": true
  },
  // Recurring tasks, due-soon / overdue reminders and SMS held for the quiet hours.
  "TaskManagement": {
    "Scheduler": {
      "Enabled": true
    },
    // Webhooks (task events sent to other systems): not used by this product. Off, nothing reads or
    // writes their tables. true: events are queued and delivered (see WebhookOptions).
    "Webhooks": {
      "Enabled": false
    }
  },
  // Cors:AllowedOrigins is deliberately not set here - it's environment-specific, so it belongs
  // in appsettings.Development.json (dev origins) or appsettings.Production.json (the real
  // deployment's origin, set at install time). See DEPLOYMENT-CONFIG.md.
  "AllowedHosts": "*"
}
