<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>tmpb-api</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.0.12" />
    <PackageReference Include="Microsoft.IdentityModel.Tokens" Version="7.7.1" />
    <PackageReference Include="Serilog.AspNetCore" Version="8.0.3" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="7.7.1" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.9.0" />
  </ItemGroup>

  <!-- TMPB consumes the platform through internal NuGet packages, not ProjectReference. -->
  <ItemGroup>
    <PackageReference Include="NexusCore.Application" Version="0.1.0" />
    <PackageReference Include="NexusCore.Infrastructure" Version="0.1.0" />
    <PackageReference Include="Chat.Api" Version="0.1.0" />
    <PackageReference Include="Chat.Application" Version="0.1.0" />
    <PackageReference Include="Chat.Infrastructure" Version="0.1.0" />
    <PackageReference Include="Notifications.Api" Version="0.1.0" />
    <PackageReference Include="Notifications.Application" Version="0.1.0" />
    <PackageReference Include="Notifications.Infrastructure" Version="0.1.0" />
    <PackageReference Include="Nexus.TaskManagement" Version="0.1.0" />
    <PackageReference Include="Nexus.TaskManagement.Infrastructure" Version="0.1.0" />
    <PackageReference Include="Nexus.Integrations.TaskNotifications" Version="0.1.0" />
  </ItemGroup>

</Project>
