<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- TEST HOST ONLY, for running the organization-structure module locally. The real Tejarat
       Bank product is built outside this repository on the NexusCore packages; remove this
       project (and its line in eng/pack-core-modules.ps1) before merging to main. -->

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>tejaratbank-api</UserSecretsId>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.0.12" />
    <PackageReference Include="Microsoft.IdentityModel.Tokens" Version="7.7.1" />
    <PackageReference Include="Serilog.AspNetCore" Version="8.0.3" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="7.7.1" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.9.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- NexusCore foundation: identity, users, roles, permissions, tenants -->
    <ProjectReference Include="..\NexusCore.Application\NexusCore.Application.csproj" />
    <ProjectReference Include="..\NexusCore.Infrastructure\NexusCore.Infrastructure.csproj" />
    <ProjectReference Include="..\NexusCore.SharedKernel\NexusCore.SharedKernel.csproj" />

    <!-- Organization units (the deputies / departments) -->
    <ProjectReference Include="..\Nexus.Organization\Nexus.Organization.csproj" />
    <ProjectReference Include="..\Nexus.Organization.Infrastructure\Nexus.Organization.Infrastructure.csproj" />

    <!-- Companies, positions, manager / subordinates (the optional module under test) -->
    <ProjectReference Include="..\Nexus.OrgStructure\Nexus.OrgStructure.csproj" />
    <ProjectReference Include="..\Nexus.OrgStructure.Infrastructure\Nexus.OrgStructure.Infrastructure.csproj" />
  </ItemGroup>

</Project>
